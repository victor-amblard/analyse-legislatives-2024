---
import type { MarkdownHeading } from 'astro';
import '../styles/global.css';
import TableOfContents from '../components/TableOfContents.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import { LOCALES, pathFor, UI, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  author?: string;
  lang: Locale;
  headings: MarkdownHeading[];
}

const { title, description, date, author, lang, headings } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={lang} />
    {/* Indique aux moteurs que les deux pages sont la même œuvre en deux langues. */}
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={`${site}${pathFor(l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}${pathFor('fr')}`} />
  </head>
  <body>
    <div class="progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="progress-fill"></div>
    </div>

    <div class="layout">
      <aside class="sidebar">
        <details class="toc-collapsible">
          <summary>{UI[lang].tocTitle}</summary>
          <TableOfContents headings={headings} lang={lang} />
        </details>
        <div class="toc-persistent">
          <TableOfContents headings={headings} lang={lang} />
        </div>
      </aside>

      <main>
        <div class="topbar">
          <LanguageToggle current={lang} />
        </div>
        <article class="prose">
          {
            (date || author) && (
              <p class="dateline">
                {author && <span>{author}</span>}
                {author && date && <span aria-hidden="true"> · </span>}
                {date && (
                  <time datetime={date.toISOString()}>
                    {date.toLocaleDateString('en-GB', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                )}
              </p>
            )
          }
          <slot />
        </article>
      </main>
    </div>

    <script>
      // --- barre de progression ------------------------------------------
      const bar = document.querySelector<HTMLElement>('.progress');
      const fill = document.querySelector<HTMLElement>('.progress-fill');

      function updateProgress() {
        if (!bar || !fill) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
        fill.style.transform = `scaleX(${pct / 100})`;
        bar.setAttribute('aria-valuenow', String(Math.round(pct)));
      }

      // --- titre courant dans le sommaire --------------------------------
      // IntersectionObserver plutôt qu'un calcul de position à chaque scroll :
      // le navigateur fait le travail hors du thread principal.
      //
      // Le sommaire est rendu DEUX fois (replié en étroit, collant en large),
      // donc un slug correspond à PLUSIEURS liens : d'où une liste par slug et
      // non un seul élément, sinon une des deux copies ne s'allume jamais.
      const links = new Map<string, HTMLAnchorElement[]>();
      const order: string[] = [];
      document.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]').forEach((a) => {
        const slug = a.dataset.tocLink;
        if (!slug) return;
        if (!links.has(slug)) {
          links.set(slug, []);
          order.push(slug);
        }
        links.get(slug)!.push(a);
      });

      const visible = new Set<string>();

      function setCurrent() {
        // Le titre actif est le PREMIER visible dans l'ordre du document, sinon
        // le sommaire saute en arrière quand plusieurs sections coexistent.
        const current = order.find((slug) => visible.has(slug));
        links.forEach((group, slug) => {
          for (const a of group) {
            if (slug === current) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          }
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const id = entry.target.id;
            if (!links.has(id)) continue;
            if (entry.isIntersecting) visible.add(id);
            else visible.delete(id);
          }
          setCurrent();
        },
        // Bande étroite en haut de la fenêtre : « la section dont le titre vient
        // de passer sous l'en-tête » plutôt que « toute section à l'écran ».
        { rootMargin: '-10% 0px -80% 0px', threshold: 0 },
      );

      links.forEach((_, slug) => {
        const el = document.getElementById(slug);
        if (el) observer.observe(el);
      });

      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });
    </script>
  </body>
</html>

<style>
  .progress {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    height: 3px;
    background: transparent;
    z-index: 10;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    will-change: transform;
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 72rem;
    margin-inline: auto;
    padding: 3rem 1.25rem 6rem;
  }

  main {
    min-width: 0; /* sans ça, un tableau large force la grille à s'élargir */
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
  }

  .topbar {
    display: flex;
    justify-content: flex-end;
    margin-block-end: 1.5rem;
  }

  .dateline {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* --- étroit : sommaire repliable en tête ---------------------------- */
  .toc-persistent { display: none; }

  .toc-collapsible {
    margin-block-end: 2.5rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface-raised);
  }

  .toc-collapsible summary {
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .toc-collapsible[open] summary { margin-block-end: 0.7rem; }

  /* --- large : sommaire collant en colonne ---------------------------- */
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3.5rem;
    }

    .sidebar {
      grid-column: 1;
    }

    .toc-collapsible { display: none; }

    .toc-persistent {
      display: block;
      position: sticky;
      inset-block-start: 3rem;
    }

    main { grid-column: 2; margin-inline: 0; }
  }

  /* La mesure de lecture reste à 44rem ; seul le canevas gagne une marge droite
     réservée aux notes. */
  @media (min-width: 80rem) {
    .layout { max-width: 92rem; }
  }
</style>
